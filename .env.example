# ==============================================================================
# ZP School Hingone BK - Environment Variables
# ==============================================================================

# Database Connection (REQUIRED in Vercel & Local)
# Note: Always include /zp_school database name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/zp_school?retryWrites=true&w=majority

# Security Secrets (REQUIRED in Production)
JWT_SECRET=replace-with-a-long-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-random-cookie-secret-min-32-chars

# Environment
NODE_ENV=production
PORT=5000

# Client URLs (optional for local dev; Vercel automatically matches deployment domains)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: Vercel Blob Storage Token (for CMS media photo uploads)
# Connect easily in Vercel Dashboard -> Storage -> Blob -> Connect to Project
BLOB_READ_WRITE_TOKEN=

# Bootstrap credentials (used by `npm run seed` and `npm run bootstrap`)
BOOTSTRAP_PRINCIPAL_NAME=Ajaykumar Patil
BOOTSTRAP_PRINCIPAL_EMAIL=principal@zphingone.edu.in
BOOTSTRAP_PRINCIPAL_USERNAME=principal
BOOTSTRAP_PRINCIPAL_PASSWORD=Principal@123
BOOTSTRAP_TEACHER_PASSWORD=Teacher@123

# Frontend API URL
# IMPORTANT FOR VERCEL: Leave this BLANK when deploying to Vercel!
# When blank, the client automatically makes same-origin requests to /api
VITE_API_URL=
