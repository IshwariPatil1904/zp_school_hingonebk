PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/zp_school
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-random-cookie-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token
BOOTSTRAP_PRINCIPAL_NAME=School Principal
BOOTSTRAP_PRINCIPAL_EMAIL=principal@your-school.edu
BOOTSTRAP_PRINCIPAL_USERNAME=principal
BOOTSTRAP_PRINCIPAL_PASSWORD=replace-with-a-secure-password
BOOTSTRAP_TEACHER_PASSWORD=replace-with-a-secure-password
VITE_API_URL=http://localhost:5000/api
